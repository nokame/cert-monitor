# --- Base de données ---
DB_PATH=data/monitor.db

# --- Seuils ---
# Jours avant expiration pour l'alerte "warning" (affichage dashboard)
WARN_DAYS=30
# Jours avant expiration pour l'alerte "critique" (affichage dashboard)
CRITICAL_DAYS=7
# Seuils d'envoi d'e-mail, en jours avant expiration (séparés par des virgules)
NOTIFY_DAYS=30

# Intervalle entre deux vérifications automatiques (heures)
CHECK_INTERVAL_HOURS=6

# --- E-mail (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alertes@example.com
SMTP_PASSWORD=changeme
SMTP_USE_TLS=true
MAIL_FROM=alertes@example.com
# Destinataires, séparés par des virgules
MAIL_TO=admin@example.com

# URL publique du dashboard (insérée dans les e-mails)
BASE_URL=http://localhost:5000
