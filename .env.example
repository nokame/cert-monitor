# --- Base de données ---
DB_PATH=data/monitor.db

# --- Surveillance ---
WARN_DAYS=30
CRITICAL_DAYS=7
NOTIFY_DAYS=30
CHECK_INTERVAL_HOURS=6

# --- E-mail (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alertes@example.com
SMTP_PASSWORD=changeme
SMTP_USE_TLS=true
MAIL_FROM=alertes@example.com
MAIL_TO=admin@example.com

# --- ACME / Let's Encrypt (v2) ---
# Production par défaut. Pour les tests, utilisez le staging :
# ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
ACME_EMAIL=admin@example.com
ACME_ACCOUNT_KEY_PATH=data/acme_account.key
ACME_OUTPUT_DIR=data/certs
# Mode par défaut des défis http-01 : webroot (IIS sert le fichier) ou standalone (port 80)
ACME_CHALLENGE_MODE=webroot
ACME_WEBROOT=C:\inetpub\wwwroot
ACME_STANDALONE_PORT=80
# Mot de passe des fichiers PFX générés et de l'import IIS
ACME_PFX_PASSWORD=cert-monitor
# Renouvellement automatique quand il reste <= N jours avant expiration
RENEW_BEFORE_DAYS=30

BASE_URL=http://localhost:5000
